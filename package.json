{
  "name": "crm-analyzer-desktop",
  "version": "1.0.0",
  "description": "Windows desktop CRM + Facebook Ads analyzer built with Electron, React, and Node.js",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm:dev:renderer\" \"npm:dev:backend\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:backend": "node backend/server.js",
    "dev:electron": "wait-on tcp:5173 tcp:3030 && electron .",
    "build:renderer": "vite build",
    "build": "npm run build:renderer",
    "preview": "vite preview"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "jspdf": "^2.5.2",
    "multer": "^1.4.5-lts.1",
    "papaparse": "^5.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.0.1",
    "electron": "^33.0.2",
    "vite": "^5.4.8",
    "wait-on": "^8.0.1"
  }
}
